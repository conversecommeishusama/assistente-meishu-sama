[Unit]
Description=Goshinsho pré-geração TTS voz Meishu-Sama (textos orais)
After=network.target goshinsho.service
Wants=goshinsho.service
# 2026-10-21: um lote travado não pode reiniciar em loop a queimar CPU. Sem
# isto, o systemd levanta o serviço indefinidamente (o lote "trava" sem sair,
# por isso Restart=on-failure não bastava).
StartLimitIntervalSec=1800
StartLimitBurst=3

[Service]
Type=simple
User=goshinsho
Group=goshinsho
WorkingDirectory=/var/www/goshinsho
Environment=HOME=/var/www/goshinsho
Environment=HF_HOME=/var/www/goshinsho/.hf_cache
# 2026-10-21: limite de CPU. Antes: --workers 5, cada daemon pedindo todos os
# 14 cores (~70 threads em 14 cores) -> load average 45 e lote travado em
# [17/71] por 13h. Agora: 2 workers x 2 threads = ~4 cores de 14, deixando
# folga real para o gunicorn atender o /api/chat.
Environment=OMP_NUM_THREADS=2
Environment=MKL_NUM_THREADS=2
Environment=OPENBLAS_NUM_THREADS=2
Environment=NUMEXPR_NUM_THREADS=2
Environment=XTTS_THREADS=2
# 2026-10-23: a fila vem de uma lista explícita, não de `--todos`. Ver
# `scripts/montar_lista_audio.py`: o âmbito é dos escritos do Meishu-Sama,
# sem periódicos nem material institucional (narrá-los na voz dele seria
# atribuir-lhe texto que não é dele).
# A lista é regenerada com: .venv/bin/python scripts/montar_lista_audio.py
# 2026-10-27: `--daemons 2` desliga o nº de obras em paralelo do nº de
# daemons. Antes eram 2 workers e 2 daemons, um para um: enquanto uma obra só
# precisava de narrador (edge) — o caso dos Relatos, primeiro da lista — um
# daemon ficava parado e o lote andava a metade. Com 4 obras em paralelo sobre
# 2 daemons (cada daemon tira as tarefas do spool uma a uma) os dois ficam
# sempre ocupados. Os workers de reserva são leves (~100 MB) e o tecto de
# memória continua a ser o do drop-in.
ExecStart=/var/www/goshinsho/venv/bin/python /var/www/goshinsho/scripts/pre_gerar_lote_orais.py --workers 4 --daemons 2 --lista /var/www/goshinsho/data/tts_lista_todos.txt
Restart=on-failure
RestartSec=30
TimeoutStartSec=300
StandardOutput=append:/var/www/goshinsho/logs/tts_pre_geracao.log
StandardError=append:/var/www/goshinsho/logs/tts_pre_geracao.log

# Hardening (2026-10-13)
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
# 2026-10-21: o lote é trabalho de fundo -- nunca deve competir de igual para
# igual com o serviço web. Sem isto, o CPU do TTS estrangula o /api/chat, que
# já é naturalmente lento (30-170s) e passaria a estourar o timeout.
Nice=10
CPUWeight=20
IOSchedulingClass=best-effort
IOSchedulingPriority=7

[Install]
WantedBy=multi-user.target
