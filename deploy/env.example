# Exemplo de variáveis — copie para `.env` e preencha.

PUBLIC_SITE_URL=https://goshinsho.com.br

# Supabase (obrigatório)
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_KEY=anon-key
# Opcional: permite enviar confirmação de cadastro via SES quando o SMTP do Supabase falhar
SUPABASE_SERVICE_ROLE_KEY=

# Resend (recomendado para confirmação de cadastro) — https://resend.com/api-keys
RESEND_API_KEY=
RESEND_FROM_EMAIL=Goshinsho <noreply@goshinsho.com.br>

# Management API — para scripts/patch_supabase_auth_config.py (site_url + redirect URLs)
# Crie em https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=

# Amazon SES (formulário de contato + fallback de confirmação de cadastro)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SES_FROM_EMAIL=
SES_CONTACT_TO_EMAIL=

# No painel Supabase (Authentication → URL Configuration), inclua:
#   https://goshinsho.com.br/app
#   https://goshinsho.com.br/app?panel=login
#   https://goshinsho.com.br/app?panel=login&confirmed=1

# ---------------------------------------------------------------------------
# Voz do Meishu-Sama (Leitura Colaborativa)
# ---------------------------------------------------------------------------
# A voz APROVADA é a do Fish Audio (modelo `s2.1-pro-free`, sem custo).
# Sem esta chave, tudo o que for gerado sai no XTTS local — que tem timbre
# mais fino (F2 ~1174 Hz contra ~858 da aprovada) e prosódia mais plana, e que
# o usuário reconheceu como "voz afeminada" a 2026-10-27.
#
# ⚠️ Esta variável tem de estar no .env do serviço que GERA áudio (o lote
# `goshinsho-tts-pregen`, que corre em /var/www/goshinsho). Entre 29/09 e
# 27/10 existiu apenas no .env do portal, e o serviço principal nunca a viu.
GOSHINSHO_FISH_AUDIO_API_KEY=

# Opcional (têm default no código): voice_id persistente na Fish e modelo.
# GOSHINSHO_FISH_VOICE_ID=ac0db2ec3d054298ad1e8bd26848588b
# GOSHINSHO_FISH_MODELO=s2.1-pro-free

# Amostra de voz do XTTS (só usada quando a chave acima está ausente).
# ⚠️ Tem de ser passada ao daemon com `--amostra`; a omissão dele é OUTRA
# amostra, mais antiga, e a voz muda em silêncio.
GOSHINSHO_XTTS_PYTHON=/var/www/goshinsho/venv_xtts/bin/python
GOSHINSHO_XTTS_AMOSTRA=/var/www/goshinsho/amostras_voz/amostra_meishu_oficial.wav
