[Unit]
Description=Acervo Studio agent (revisão autónoma Gokōwa)
After=network.target goshinsho.service

[Service]
Type=simple
User=root
WorkingDirectory=/var/www/goshinsho
Environment=PYTHONUNBUFFERED=1
ExecStart=/var/www/goshinsho/venv/bin/python -u scripts/acervo_studio_agent.py --resume
Restart=on-failure
RestartSec=60

[Install]
WantedBy=multi-user.target
